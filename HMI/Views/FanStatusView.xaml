<UserControl x:Class="HMI.Views.FanStatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HMI.Views"
              xmlns:viewmodel="clr-namespace:HMI.ViewModels"
 d:DataContext="{d:DesignInstance Type=viewmodel:FanStatusViewModel}"
             mc:Ignorable="d" 
               Background="White"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>


        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0 0 0 10">
            <TextBlock Style="{DynamicResource title}" Text="{Binding Title , FallbackValue=' FanStatus'}"/>

        </StackPanel>

        <ListView Grid.Row="1" ItemsSource="{Binding Fanitems}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Width="150" Header="ID" DisplayMemberBinding="{Binding Id}"/>
                    <GridViewColumn Width="150" Header="IsRunning" DisplayMemberBinding="{Binding IsRunning}"/>
                    <GridViewColumn Width="80" Header="Speed" DisplayMemberBinding="{Binding Speed}"/>
                   
                </GridView>
            </ListView.View>
        </ListView>

    </Grid>
</UserControl>
