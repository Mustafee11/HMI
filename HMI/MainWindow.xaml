<Window x:Class="HMI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HMI"
        xmlns:viewmodels="clr-namespace:HMI.ViewModels"
        xmlns:views="clr-namespace:HMI.Views"
        d:DataContext="{d:DesignInstance Type=viewmodels:MainViewModel}"
        mc:Ignorable="d"
        Background="Black"
        WindowStartupLocation="CenterScreen"
        Title="HMI" Height="450" Width="800">
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <ContentControl Grid.Row="0" Content="{Binding CurrentViewModel}">
            <ContentControl.Resources>
                <DataTemplate DataType="{x:Type viewmodels:HomeViewModel}">
                    <views:HomeView/>
                </DataTemplate>
                <DataTemplate DataType="{x:Type viewmodels:AlertViewModel}">
                    <views:AlertView/>
                </DataTemplate>

                <DataTemplate DataType="{x:Type viewmodels:FanStatusViewModel}">
                    <views:FanStatusView/>
                </DataTemplate>

                <DataTemplate DataType="{x:Type viewmodels:CommandControlViewModel}">
                    <views:ControlFanView/>
                </DataTemplate>

            </ContentControl.Resources>
        </ContentControl>

        <StackPanel FocusManager.FocusedElement="{Binding ElementName=Homebtn}" Grid.Row="1" Orientation="Horizontal" >

           
            <Button x:Name="Homebtn" Style="{DynamicResource btn}" Command="{Binding NavigateToHomeCommand}" Content=" Home"/>
            <Button  Style="{DynamicResource btn}" Command="{Binding NavigateToAlertCommand}" Content="Alert"/>
            <Button  Style="{DynamicResource btn}" Command="{Binding NavigateToFanStatusCommand}" Content="FanStatus"/>
            <Button  Style="{DynamicResource btn}" Command="{Binding NavigateToControlFanCommand}" Content="ControlFan"/>

        </StackPanel>



    </Grid>
</Window>
